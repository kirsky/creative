{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "maxNodeModuleJsDepth": 0,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": [".", "../playwright.config.js"],
  "exclude": [".results"]
}
