{
  "name": "creative-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Creative task system SPA (React, JavaScript with JSDoc types)",
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "i18n:check": "node scripts/check-i18n-keys.js",
    "test": "jest",
    "check": "npm run lint && npm run format:check && npm run stylelint && npm run typecheck && npm run i18n:check && npm run test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@hookform/resolvers": "7.0.5",
    "@mantine/core": "9.8.0",
    "@mantine/dates": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@mantine/notifications": "9.8.0",
    "@tanstack/react-query": "5.107.1",
    "dayjs": "1.11.23",
    "i18next": "27.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "18.0.1",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-jest": "30.5.2",
    "babel-loader": "10.1.1",
    "css-loader": "7.1.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "html-webpack-plugin": "5.6.8",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "mini-css-extract-plugin": "2.10.2",
    "prettier": "3.9.10",
    "sass": "1.108.1",
    "sass-loader": "17.1.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "7.0.2",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1"
  }
