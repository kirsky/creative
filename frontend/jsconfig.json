{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": { "dayjs/locale/*": ["./src/types/dayjs-locale.d.ts"] },
    "noUncheckedSideEffectImports": false,
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["jest"]
  },
  "include": ["src", "jest.setup.js"],
  "exclude": [
    "node_modules",
    "dist",
    "src/test/jsdomEnvironment.js",
    "src/test/globalSetup.js",
    "src/test/styleStub.js"
  ]
}
