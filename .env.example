# Do not copy this file by hand: `make init` writes .env from it and fills in
# freshly generated passwords. .env is never committed.

APP_ENV=demo

# Host user the PHP and Node containers run as, so that files they write into
# the bind-mounted backend/ and frontend/ stay owned by you (make init sets these).
HOST_UID=1000
HOST_GID=1000

# Database. Passwords are generated by `make init` and have no default.
DB_NAME=creative
DB_TEST_NAME=creative_test
DB_USER=creative
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Uploaded files live outside any web root, on the `uploads` volume mounted here.
UPLOAD_DIR=/var/uploads
# Per-file limit in bytes, just under Cloudflare Free's 100 MB request body cap.
# nginx client_max_body_size (docker/nginx/default.conf) is this + 10 MB.
MAX_UPLOAD_BYTES=99000000

# Browsers reach the app over HTTPS (Cloudflare + host nginx), so cookies are Secure.
SESSION_COOKIE_SECURE=1

# Proxies whose X-Forwarded-* headers the app may trust: the container nginx and,
# behind it, the host nginx, all inside Docker's private address ranges.
TRUSTED_PROXIES=172.16.0.0/12
