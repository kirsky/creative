#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Demo\Cli\ResetCommand;
use App\Demo\Cli\SeedCommand;
use App\Demo\Cli\SeedIfEmptyCommand;
use App\Identity\Cli\RotateCredentialsCommand;
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Command\Command;

use function App\createContainer;

if (PHP_SAPI !== 'cli') {
    exit(1);
}

require __DIR__ . '/../vendor/autoload.php';

$container = createContainer();

$application = new Application('Creative task system');

// Commands are resolved through the container. Later tasks register theirs here.
/** @var list<class-string<Command>> $commandClasses */
$commandClasses = [
    RotateCredentialsCommand::class,
    SeedCommand::class,
    ResetCommand::class,
    SeedIfEmptyCommand::class,
];

foreach ($commandClasses as $commandClass) {
    $command = $container->get($commandClass);
    if (!$command instanceof Command) {
        throw new LogicException(sprintf('%s is not a console command.', $commandClass));
    }

    $application->addCommand($command);
}

exit($application->run());
