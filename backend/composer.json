{
    "name": "creative/task-system",
    "description": "Creative task system: Slim 4 JSON API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "monolog/monolog": "^3.9",
        "php-di/php-di": "^7.1",
        "robmorgan/phinx": "^0.16",
        "slim/psr7": "^1.7",
        "slim/slim": "4.15.3",
        "symfony/console": "^7.3",
        "symfony/validator": "^7.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.90",
        "opis/json-schema": "^2.4",
        "phpstan/phpstan": "2.3.5",
        "phpunit/phpunit": "13.4.*",
        "symfony/yaml": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "process-timeout": 0
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff --show-progress=none --config=.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "stan": "phpstan analyse --memory-limit=1G --no-progress",
        "test": "phpunit",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ],
        "demo:credentials:rotate": "php bin/console demo:credentials:rotate"
    },
    "scripts-descriptions": {
        "cs": "Check code style (PER-CS) without changing files",
        "cs:fix": "Fix code style (PER-CS)",
        "stan": "Static analysis, PHPStan level 10",
        "test": "Run PHPUnit",
        "check": "Run every backend quality gate: cs, stan, test",
        "demo:credentials:rotate": "Generate new demo passwords and invalidate sessions (CLI only, APP_ENV=demo)"
    }
}
