.env

# PHP
backend/vendor/
backend/var/
.php-cs-fixer.cache
.phpunit.cache/
.phpunit.result.cache

# Node
frontend/node_modules/
frontend/.npm-cache/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/

# Build output (the directory itself is kept through .gitkeep)
frontend/dist/*
!frontend/dist/.gitkeep

*.log
# Playwright reports, failure artifacts and screenshots (make e2e)
frontend/e2e/.results/
